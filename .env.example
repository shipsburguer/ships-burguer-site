# Provedor aceito: callmebot, custom, meta, evolution ou zapi
WHATSAPP_API_PROVIDER=callmebot

# Numero que deve receber os avisos do chatbot, com DDI e DDD
WHATSAPP_NOTIFY_TO=5511976374369

# Para CallMeBot
CALLMEBOT_API_KEY=

# Para custom/zapi/evolution
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Para Evolution API
WHATSAPP_INSTANCE=

# Para Z-API, quando houver Client-Token
WHATSAPP_CLIENT_TOKEN=

# Para WhatsApp Cloud API oficial da Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0

# Opcional para provider custom
WHATSAPP_AUTH_HEADER=Authorization
WHATSAPP_AUTH_PREFIX=Bearer
